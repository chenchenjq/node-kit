{
  "name": "area-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.1 <23"
  },
  "files": [
    "dist",
    "scripts/area-kit.mjs",
    "migrations",
    "examples",
    "licenses",
    "README.md",
    "DATABASE.md",
    "DATA-SOURCE.md",
    "AI-USAGE.md"
  ],
  "bin": {
    "area-kit": "./scripts/area-kit.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "browser": "./dist/browser-forbidden.js",
      "react-server": "./dist/server/next.js",
      "import": "./dist/server/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "browser": "./dist/browser-forbidden.js",
      "react-server": "./dist/postgres/next.js",
      "import": "./dist/postgres/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:postgres": "node scripts/verify-postgres.mjs",
    "test:full": "node scripts/verify-full.mjs",
    "test:pack": "node scripts/verify-pack.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "data:prepare": "node scripts/area-kit.mjs prepare",
    "data:check": "node scripts/area-kit.mjs check",
    "data:import": "node scripts/area-kit.mjs import",
    "data:activate": "node scripts/area-kit.mjs activate"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "server-only": "0.0.1"
  },
  "peerDependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "react": "19.3.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "playwright-core": "1.51.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "testcontainers": "12.1.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.0.18"
  }
}
