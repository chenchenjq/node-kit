{
  "name": "sku-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.1 <23" },
  "files": ["dist", "migrations", "examples/next", "README.md", "DATABASE.md", "AI-USAGE.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./server": { "types": "./dist/server/index.d.ts", "browser": "./dist/browser-forbidden.js", "react-server": "./dist/server/next.js", "import": "./dist/server/index.js" },
    "./postgres": { "types": "./dist/postgres/index.d.ts", "browser": "./dist/browser-forbidden.js", "react-server": "./dist/postgres/next.js", "import": "./dist/postgres/index.js" },
    "./client": { "types": "./dist/client/index.d.ts", "import": "./dist/client/index.js" },
    "./react": { "types": "./dist/react/index.d.ts", "import": "./dist/react/index.js" },
    "./testing": { "types": "./dist/testing/index.d.ts", "browser": "./dist/browser-forbidden.js", "react-server": "./dist/testing/next.js", "import": "./dist/testing/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:pack": "npm run build && node scripts/verify-pack.mjs"
  },
  "dependencies": { "server-only": "0.0.1" },
  "peerDependencies": { "drizzle-orm": "0.45.2", "pg": "8.23.0", "react": "19.3.0" },
  "peerDependenciesMeta": {
    "drizzle-orm": { "optional": true },
    "pg": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "testcontainers": "12.1.0",
    "typescript": "7.0.2",
    "vitest": "4.0.18"
  }
}
